rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string &&
             id.size() >= 1 &&
             id.size() <= 128 &&
             id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidVoiceMemo(data, userId) {
      return data.keys().hasAll(['userId', 'content', 'createdAt', 'updatedAt']) &&
             data.keys().hasOnly(['userId', 'content', 'createdAt', 'updatedAt']) &&
             data.userId is string &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.content is string &&
             data.content.size() >= 1 && data.content.size() <= 5000 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/memos/{memoId} {
      allow get: if isOwner(userId) && isValidId(memoId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(memoId) &&
                       isValidVoiceMemo(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(memoId) &&
                       isValidVoiceMemo(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(memoId);
    }
  }
}
